#!/bin/bash
# Records Spotify audio per-track (MPRIS-driven), saves each track as a
# tagged MP3, then runs ace-server /understand on it and appends the
# augmented JSON (with artist/album/title) as one line to
# state/spotify_understood.jsonl.
#
# Usage:
#   ./rip                                  # save mp3s under ./Music/, jsonl to state/
#   ./rip path/to/music_root               # alternate music root
#   ./rip --jsonl other.jsonl path/to/root # custom jsonl path
#
# Combines the Spotify-ripper recording loop with ./understand. Requires
# Spotify to be playing through PipeWire-pulse / PulseAudio.

set -u
script_dir=$(cd "$(dirname "$0")" && pwd)
cd "$script_dir"

musicdir=""
jsonl_path="$script_dir/state/spotify_understood.jsonl"
while [[ $# -gt 0 ]]; do
  case $1 in
    --jsonl) jsonl_path=$2; shift ;;
    -h|--help)
      echo "Usage: $0 [--jsonl <path>] [music_directory]" >&2
      exit 0 ;;
    *) musicdir=$1 ;;
  esac
  shift
done
musicdir=${musicdir:-"$script_dir/Music"}

deps=(pactl parec playerctl wget awk lame id3v2 stdbuf python3)
for cmd in "${deps[@]}"; do
  command -v "$cmd" >/dev/null || { echo "missing dependency: $cmd" >&2; exit 1; }
done

mkdir -p "$musicdir" "$(dirname "$jsonl_path")"

# --- Spotify sink-input detection -------------------------------------------
spotify_clients=$(pactl list clients | awk '
  /^Client #/ {
    if (cid != "" && hit) print cid
    sub("#","",$2); cid=$2; hit=0
  }
  /application\.(name|process\.binary)/ && tolower($0) ~ /"spotify"/ { hit=1 }
  END { if (cid != "" && hit) print cid }
')

spotify=$(pactl list sink-inputs | awk -v ids="$spotify_clients" '
  BEGIN { n = split(ids, arr, "\n"); for (i = 1; i <= n; i++) m[arr[i]] = 1 }
  /^Sink Input #/ { sub("#","",$3); idx = $3 }
  /^[[:space:]]+Client:[[:space:]]/ { if ($2 in m) { print idx; exit } }
')

if [[ -z $spotify ]]; then
  echo "Spotify is not running (no sink-input found). Play a song first." >&2
  exit 1
fi

# Create our recording sink if not already present
if ! pactl list short sinks | awk '{print $2}' | grep -qx spotify; then
  pactl load-module module-null-sink \
    sink_name=spotify sink_properties=device.description=SpotifyRipper >/dev/null
fi

default_sink=$(pactl get-default-sink)
rec_pid=""
loopback_module=""

cleanup() {
  [[ -n $rec_pid ]] && pkill -P "$rec_pid" 2>/dev/null
  [[ -n $loopback_module ]] && pactl unload-module "$loopback_module" 2>/dev/null
  pactl move-sink-input "$spotify" "$default_sink" 2>/dev/null
}
trap cleanup EXIT INT TERM

# Move Spotify into our isolated sink so audio is captured cleanly
pactl move-sink-input "$spotify" spotify

# Loopback so the user can still hear playback in real time
loopback_module=$(pactl load-module module-loopback \
  source=spotify.monitor sink="$default_sink" latency_msec=50)

# --- per-track state --------------------------------------------------------
artist=""; album=""; title=""; tracknumber=""

stop_recording() {
  [[ -z $rec_pid ]] && return
  pkill -P "$rec_pid" 2>/dev/null
  wait "$rec_pid" 2>/dev/null
  rec_pid=""
}

finalize_and_understand() {
  local tmpfile=tmp.mp3
  [[ -z $title ]] && return
  [[ -s $tmpfile ]] || return

  id3v2 -a "$artist" -A "$album" -t "$title" -T "$tracknumber" "$tmpfile" >/dev/null

  local saveto="$musicdir/${artist//\//_}/${album//\//_}"
  mkdir -p "$saveto"
  local prefix=""
  [[ $tracknumber =~ ^[0-9]+$ ]] && prefix=$(printf '%02d ' "$tracknumber")
  local target="$saveto/${prefix}${title//\//_}.mp3"
  mv "$tmpfile" "$target"
  echo "Saved: $target"

  if [[ -s cover.jpg && ! -e "$saveto/cover.jpg" ]]; then
    mv cover.jpg "$saveto/cover.jpg"
  fi
  rm -f cover.jpg

  # /understand the freshly saved track AND run an /lm 'inspire' enhance
  # pass that dreams lyrics fitting the understood caption. Both forms
  # land in the JSONL record (lyrics + enhanced_lyrics), keeping the
  # audio_codes too so we can replay/repaint later.
  env PYTHONPATH="$script_dir/src${PYTHONPATH:+:$PYTHONPATH}" \
    python3 -m markovsound.cli_understand \
      --no-save --enhance --jsonl "$jsonl_path" \
      --artist "$artist" --album "$album" \
      --title  "$title"  --track "$tracknumber" \
      "$target" \
    || echo "understand failed for $target (continuing)" >&2
}

# --- MPRIS metadata stream (inlined notify.sh) ------------------------------
mpris_stream() {
  # `playerctl --follow` already emits the currently-playing track once on
  # startup, so we don't need a separate one-shot. mawk block-buffers stdin
  # by default — `-Winteractive` (gawk-compatible: `-Wint`) makes it line-
  # buffered so per-track lines flow through immediately.
  stdbuf -oL playerctl --player=spotify --follow metadata --format \
    '{{ mpris:trackid }}|{{ artist }}|{{ album }}|{{ title }}|{{ xesam:trackNumber }}|{{ mpris:artUrl }}' |
  awk -Winteractive -F'|' -v ORS='\n' '
    {
      trackid=$1; if (trackid == "" || trackid == prev) next
      prev = trackid
      print "__SWITCH__"
      print "artist="$2
      print "album="$3
      print "title="$4
      print "tracknumber="$5
      print "arturl="$6
      fflush()
    }
  '
}

# --- main loop --------------------------------------------------------------
while read -r line; do
  if [[ $line == "__SWITCH__" ]]; then
    stop_recording
    finalize_and_understand
    artist=""; album=""; title=""; tracknumber=""

    echo "RECORDING"
    ( parec -d spotify.monitor |
      lame -r -s 44.1 --bitwidth 16 --signed --little-endian -m s -b 192 - tmp.mp3
    ) 2>/dev/null &
    rec_pid=$!
  else
    key=${line%%=*}
    val=${line#*=}
    case $key in
      artist)      artist=$val;      echo "Artist = $val" ;;
      album)       album=$val;       echo "Album  = $val" ;;
      title)       title=$val;       echo "Title  = $val" ;;
      tracknumber) tracknumber=$val; echo "Track# = $val" ;;
      arturl)
        if [[ -n $val ]]; then
          wget -q -O cover.jpg "$val" || rm -f cover.jpg
        fi
        ;;
    esac
  fi
done < <(mpris_stream)
