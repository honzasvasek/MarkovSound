#!/bin/bash
# Play the newest queued track. ./create fills Audio/queue/; when generation
# runs freely and builds a backlog, older queued tracks are discarded so
# playback jumps to the most recent render.
#
# Key bindings during playback (via scripts/play_keys.lua):
#   INS  → ./keep <track>        (boost caption, keep playing)
#   DEL  → ./verwijder <track>   (untrain + delete, skip to next)
set -eu
here="$(cd "$(dirname "$0")" && pwd)"
audio_dir="$here/Audio"
queue_dir="$audio_dir/queue"
archive_dir="$audio_dir/archive"
state_dir="$here/state"
now_playing="$state_dir/now_playing.json"
export MARKOVSOUND_ROOT="$here"

mkdir -p "$queue_dir" "$archive_dir" "$state_dir"

cleanup() {
    rm -f "$now_playing"
    echo; echo "stopped."; exit 0;
}
trap cleanup INT TERM

next_queued() {
    find "$queue_dir" -maxdepth 1 -type f -name '*.mp3' | sort | tail -n 1
}

prune_older_queued() {
    keep="$1"
    find "$queue_dir" -maxdepth 1 -type f -name '*.mp3' | sort | while IFS= read -r old; do
        [ "$old" = "$keep" ] && continue
        old_sidecar="${old%.mp3}.json"
        echo "discarding stale queued render: $(basename "$old")"
        rm -f "$old" "$old_sidecar"
    done
}

while true; do
    current="$(next_queued || true)"
    if [ -z "$current" ]; then
        echo "queue empty; waiting..."
        sleep 5
        continue
    fi
    prune_older_queued "$current"
    # Resolve the claimed track into its physical session directory now.  The
    # root Audio/ symlink may be switched while mpv is playing; archiving must
    # still go back to the session this track came from.
    current="$(readlink -f "$current")"
    session_audio_dir="$(dirname "$(dirname "$current")")"
    session_archive_dir="$session_audio_dir/archive"
    mkdir -p "$session_archive_dir"
    name="$(basename "$current")"
    sidecar="${current%.mp3}.json"
    [ -f "$sidecar" ] || { sleep 1; continue; }
    cap="$(python3 -c "
import json, sys
d = json.load(open(sys.argv[1]))
dur = d.get('duration', 0)
d_s = f'{int(dur//60)}:{int(dur%60):02d}' if dur else '?'
print(d.get('caption', 'N/A'))
print(f\"  ↳ {d.get('trained_caption', 'N/A')}\")
print(f\"  {d.get('bpm', '?')} BPM | {d_s} | {d.get('keyscale', '?')} | {d.get('timesignature', '?')}/4\")
lyr = (d.get('used_lyrics') or d.get('lyrics') or '').strip()
if lyr and lyr != '[Instrumental]':
    lang = d.get('vocal_language') or '?'
    src = d.get('lyrics_source') or '?'
    print(f'  --- used lyrics ({lang}, src={src}) ---')
    for line in lyr.splitlines():
        print(f'  {line}')
" "$sidecar" 2>/dev/null || true)"
    echo "▶ $name"
    echo "$cap"
    python3 -c "
import json, os, sys, time
sidecar, now_playing, filename = sys.argv[1:]
try:
    d = json.load(open(sidecar)); duration = float(d.get('duration') or 0)
except Exception:
    duration = 0
data = {'file': filename, 'started_at': time.time(), 'duration': duration}
tmp = now_playing + '.tmp'
with open(tmp, 'w') as f: json.dump(data, f)
os.replace(tmp, now_playing)
" "$sidecar" "$now_playing" "$name" 2>/dev/null || true
    export MARKOVSOUND_ORIGINAL_PATH="$current"
    mpv --no-video --really-quiet \
        --script="$here/scripts/play_keys.lua" \
        --term-status-msg='  ${time-pos} / ${duration}  [INS=keep DEL=verwijder]' \
        "$current" || true
    if [ -f "$current" ]; then
        mv "$current" "$session_archive_dir/$name"
        [ -f "$sidecar" ] && mv "$sidecar" "$session_archive_dir/${name%.mp3}.json"
    fi
done
