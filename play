#!/bin/bash
# Play the most recently written slot track, then jump to whatever is newest
# when it ends. The rotating slot pool (01..10.mp3) means "newest" is by mtime,
# not by number.
#
# Key bindings during playback (via scripts/play_keys.lua):
#   INS  → ./keep <track>        (boost caption, keep playing)
#   DEL  → ./verwijder <track>   (untrain + delete, skip to next)
set -eu
here="$(cd "$(dirname "$0")" && pwd)"
audio_dir="$here/Audio"
state_dir="$here/state"
now_playing="$state_dir/now_playing.json"
# Per-playback temp copy of the slot mp3. ./create rotates slot files and
# may overwrite the file we're playing mid-track; mpv then either glitches
# or crashes. Copying first means the running playback is decoupled from
# disk activity.
play_temp_dir="$state_dir/now_playing.d"
export MARKOVSOUND_ROOT="$here"

mkdir -p "$state_dir" "$play_temp_dir"

cleanup() {
    rm -f "$now_playing"
    rm -rf "$play_temp_dir"
    echo; echo "stopped."; exit 0;
}
trap cleanup INT TERM

last_played=""
while true; do
    # Newest 01..10.mp3 by modification time.
    latest="$(ls -1t "$audio_dir"/[0-9][0-9].mp3 2>/dev/null | head -n 1 || true)"
    if [ -z "$latest" ]; then
        echo "no tracks in $audio_dir yet; waiting..."
        sleep 5
        continue
    fi
    name="$(basename "$latest")"
    if [ "$latest" != "$last_played" ]; then
        sidecar="${latest%.mp3}.json"
        if [ -f "$sidecar" ]; then
            cap="$(python3 -c "
import json, sys
d = json.load(open(sys.argv[1]))
dur = d.get('duration', 0)
d_s = f'{int(dur//60)}:{int(dur%60):02d}' if dur else '?'
print(d.get('caption', 'N/A'))
print(f\"  ↳ {d.get('trained_caption', 'N/A')}\")
print(f\"  {d.get('bpm', '?')} BPM | {d_s} | {d.get('keyscale', '?')} | {d.get('timesignature', '?')}/4\")
lyr = (d.get('used_lyrics') or d.get('lyrics') or '').strip()
if lyr and lyr != '[Instrumental]':
    lang = d.get('vocal_language') or '?'
    src = d.get('lyrics_source') or '?'
    print(f'  --- used lyrics ({lang}, src={src}) ---')
    for line in lyr.splitlines():
        print(f'  {line}')
" "$sidecar" 2>/dev/null || true)"
            echo "▶ $name"
            echo "$cap"
        else
            echo "▶ $name"
        fi
    else
        echo "↻ $name (no newer slot yet)"
    fi
    last_played="$latest"
    # Snapshot the mp3 to our private temp dir BEFORE we hand it to mpv.
    # cp first to a .partial file then mv into place so mpv never opens a
    # half-written file. If anything fails, fall back to playing the
    # original (back to the racy behaviour, but better than not playing).
    temp_mp3="$play_temp_dir/$name"
    if cp -f "$latest" "$temp_mp3.partial" 2>/dev/null && mv -f "$temp_mp3.partial" "$temp_mp3" 2>/dev/null; then
        playback_path="$temp_mp3"
    else
        playback_path="$latest"
    fi
    # Publish "now playing" state so ./create can sync its generation rate
    # to the player. File is removed on exit (cleanup trap) and rewritten
    # atomically per track.
    python3 -c "
import json, os, sys, time
sidecar = sys.argv[1]
now_playing = sys.argv[2]
filename = sys.argv[3]
try:
    d = json.load(open(sidecar))
    duration = float(d.get('duration') or 0)
except Exception:
    duration = 0
data = {'file': filename, 'started_at': time.time(), 'duration': duration}
tmp = now_playing + '.tmp'
with open(tmp, 'w') as f:
    json.dump(data, f)
os.replace(tmp, now_playing)
" "$sidecar" "$now_playing" "$name" 2>/dev/null || true
    # Tell the lua keybinding script which slot file this temp copy came
    # from so keep/verwijder act on the real slot, not the temp.
    export MARKOVSOUND_ORIGINAL_PATH="$latest"
    mpv --no-video --really-quiet \
        --script="$here/scripts/play_keys.lua" \
        --term-status-msg='  ${time-pos} / ${duration}  [INS=keep DEL=verwijder]' \
        "$playback_path" || true
done
